{
  "name": "folderspec-vscode",
  "displayName": "FolderSpec",
  "description": "Declare your repo's intended structure for AI agents · 可视化声明仓库结构意图，产出给 Agent 遵守的契约",
  "keywords": [
    "ai agent",
    "folder structure",
    "architecture",
    "claude",
    "documentation",
    "monorepo",
    "cursor",
    "copilot",
    "codebase",
    "convention"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Litianyu141/FolderSpecForAgent.git"
  },
  "license": "Apache-2.0",
  "homepage": "https://github.com/Litianyu141/FolderSpecForAgent#readme",
  "bugs": {
    "url": "https://github.com/Litianyu141/FolderSpecForAgent/issues"
  },
  "version": "0.6.1",
  "icon": "icon.png",
  "publisher": "folderspec",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onCommand:folderspec.open"
  ],
  "contributes": {
    "customEditors": [
      {
        "viewType": "folderspec.editor",
        "displayName": "FolderSpec Structure Contract",
        "selector": [
          {
            "filenamePattern": ".folderspec.md"
          }
        ],
        "priority": "default"
      }
    ],
    "commands": [
      {
        "command": "folderspec.open",
        "title": "FolderSpec: Open structure contract"
      }
    ]
  },
  "scripts": {
    "build": "pnpm -C ../core build && pnpm -C ../ui build && node scripts/copy-ui.mjs && esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node",
    "vscode:prepublish": "pnpm build",
    "test": "vitest run",
    "test:e2e": "tsc -p tsconfig.test.json && node dist-test/test/runTest.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@folderspec/core": "workspace:*",
    "@folderspec/ui": "workspace:*",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.10.2",
    "@types/vscode": "^1.90.0",
    "@vscode/test-electron": "^2.4.1",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.24.0",
    "glob": "^11.0.0",
    "mocha": "^10.8.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
